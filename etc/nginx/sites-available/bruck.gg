# ========================
# HTTPS Server Block (Port 443)
# Serves https://bruck.gg and https://www.bruck.gg
# ========================
server {
    server_name bruck.gg www.bruck.gg;

    root /var/www/bruck.gg;
    index index.html;

    location / {
        try_files $uri $uri/ =404;
    }

    # Current dashboard uses same-origin cached state, independent of Pi latency.
    location /enclosure/ {
        proxy_pass http://127.0.0.1:8011/;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_connect_timeout 1s;
        proxy_read_timeout 5s;
        proxy_send_timeout 5s;
        client_max_body_size 16k;
    }

    # /test -> /test.html (no redirect)
    location /test {
        rewrite ^/test/?$ /test.html break;
    }

    # Serve React app (static files) at /smart
    location = /smart { return 301 /smart/; }
    location /smart/ {
        alias /var/www/react-app/dist/;
        try_files $uri /smart/index.html;
        add_header Cache-Control "no-cache";
    }

    # On-demand same-origin camera reader and WebRTC signalling.
    location /camera/ {
        proxy_pass http://100.110.157.122:8889/cam/;
        proxy_redirect /cam/ /camera/;
        proxy_set_header Host $host;
        proxy_http_version 1.1;
        proxy_buffering off;
        proxy_read_timeout 30s;
    }

    # SSL (Certbot)
    listen 443 ssl;
    ssl_certificate     /etc/letsencrypt/live/bruck.gg/fullchain.pem;  # managed by Certbot
    ssl_certificate_key /etc/letsencrypt/live/bruck.gg/privkey.pem;    # managed by Certbot
    include             /etc/letsencrypt/options-ssl-nginx.conf;
    ssl_dhparam         /etc/letsencrypt/ssl-dhparams.pem;
}

# ========================
# HTTPS Server Block for api.bruck.gg
# Proxies to Express (AWS) on :3011 and to Pi on :3010
# ========================
server {
    server_name api.bruck.gg;

    listen 443 ssl http2;
    ssl_certificate     /etc/letsencrypt/live/api.bruck.gg/fullchain.pem; # managed by Certbot
    ssl_certificate_key /etc/letsencrypt/live/api.bruck.gg/privkey.pem;   # managed by Certbot
    include             /etc/letsencrypt/options-ssl-nginx.conf;
    ssl_dhparam         /etc/letsencrypt/ssl-dhparams.pem;

    # ------------------------
    # Default: proxy all other API routes to Node on localhost:3011
    # ------------------------
    location / {
        proxy_pass http://localhost:3011/;
        proxy_http_version 1.1;
        proxy_set_header Host              $host;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Upgrade           $http_upgrade;
        proxy_set_header Connection        $connection_upgrade;
        proxy_cache_bypass                 $http_upgrade;
    }

    # ------------------------
    # AWS LOGS (SSE) at https://api.bruck.gg/logs
    # Disable buffering so events stream immediately
    # ------------------------
    location /logs {
        proxy_pass http://localhost:3011/logs;
        proxy_http_version 1.1;
        proxy_set_header Host $host;

        # SSE essentials
        proxy_buffering off;
        proxy_set_header Connection "";
        chunked_transfer_encoding off;
        gzip off;
        proxy_read_timeout 1h;
        proxy_send_timeout 1h;
    }

# ------------------------
    # PI REVERSE PROXY under /pi/*
    # Routes to FastAPI on Port 8000
    # ------------------------
    location /pi/ {
        # IMPORTANT: trailing slash keeps subpaths intact
        proxy_pass http://100.110.157.122:8000/;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        # Add this line so FastAPI knows its subpath:
        proxy_set_header X-Forwarded-Prefix /pi; 
    }  
# ------------------------
    # MediaMTX WebRTC Camera Feed
    # Routes to Pi on Port 8889
    # ------------------------
    location /pi/cam/ {
        # IMPORTANT: The trailing slashes are required here.
        # "cam" is the default stream name. If you named your stream 
        # something else in your ffmpeg script, change it here.
        proxy_pass http://100.110.157.122:8889/cam/; 
        
        # Rewrites the absolute path MediaMTX sends back to include the proxy subpath
        proxy_redirect /cam/ /pi/cam/;
        
        proxy_http_version 1.1;
        
        # These two headers are mandatory for WebRTC/WebSockets
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }      
}

# ========================
# HTTP -> HTTPS for api.bruck.gg
# ========================
server {
    if ($host = api.bruck.gg) {
        return 301 https://$host$request_uri;
    } # managed by Certbot

    listen 80;
    server_name api.bruck.gg;
    return 301 https://$host$request_uri;
}

# ========================
# HTTP -> HTTPS for bruck.gg / www.bruck.gg
# ========================
server {
    if ($host = www.bruck.gg) {
        return 301 https://$host$request_uri;
    } # managed by Certbot

    if ($host = bruck.gg) {
        return 301 https://$host$request_uri;
    } # managed by Certbot

    listen 80;
    server_name bruck.gg www.bruck.gg;
    return 404;
}

# ------------------------
# Helper: make $connection_upgrade work
# (put in http{} or here if not already present)
# ------------------------
map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}
